# Vorlage für die lokale Konfiguration. Kopieren nach `.env` und Werte eintragen.
# `.env` wird nie committet.

# Postgres mit pgvector (Service `db` in docker-compose.yml).
# Das Passwort ist nur für die lokale Entwicklung gedacht; für ein Deployment ändern.
POSTGRES_USER=parlrag
POSTGRES_PASSWORD=parlrag
POSTGRES_DB=parlrag
# Lokal (uv): 127.0.0.1 (nicht localhost, siehe plan.md). Im Container setzt docker-compose.yml `db`.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# LLM (ab Phase 4): api = Anthropic-API mit API-Key (Container, API, Demo);
# claude-code = eigenes Claude-Abo über die lokal installierte Claude-Code-CLI
# (nur lokal mit uv, nur für die eigene Nutzung; ANTHROPIC_API_KEY bleibt dann leer)
LLM_BACKEND=api
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=high

# Generierung: Anzahl Chunks, die als nummerierte Quellen ans LLM gehen
ANSWER_CONTEXT_CHUNKS=8

# OData-Dienst der Parlamentsdienste (kein API-Key nötig). Bitte schonend abfragen.
ODATA_BASE_URL=https://ws.parlament.ch/odata.svc/
ODATA_MIN_INTERVAL_SECONDS=1.0
ODATA_MAX_RETRIES=5
ODATA_TIMEOUT_SECONDS=60
# Rohdaten-Cache (wird nicht committet; im Container per Bind-Mount ./data/raw)
RAW_CACHE_DIR=data/raw

# Chunking: Zielgrösse in Tokens (Höchstgrösse = 1,2 × Ziel) und Overlap-Anteil
CHUNK_TARGET_TOKENS=500
CHUNK_OVERLAP_RATIO=0.15

# Embeddings: lokales Modell (Download beim ersten Gebrauch, im Container ins Volume hf-cache)
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_SEQ_LENGTH=1024

# Index: Kontext-Header beim Einbetten (true/false). Eine Änderung löst bei
# `parlrag index` die Neuindexierung aus (Index-Signatur).
INDEX_CONTEXT_HEADER=true

# Retrieval: Standard-Suchart (vector, fulltext oder hybrid; Entscheid Task 3.3),
# Kandidaten je Suchart (Volltext, Vektor), RRF-Konstante k, Anzahl Treffer
RETRIEVAL_MODE=vector
RETRIEVAL_CANDIDATES=50
RETRIEVAL_RRF_K=60
RETRIEVAL_TOP_N=20
