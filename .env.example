# Vorlage für die lokale Konfiguration. Kopieren nach `.env` und Werte eintragen.
# `.env` wird nie committet.

# Postgres mit pgvector (läuft im Container, siehe docker-compose.yml ab Task 0.3)
DATABASE_URL=postgresql://parlrag:parlrag@localhost:5432/parlrag

# Claude API (erst ab Phase 4 nötig)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=high
